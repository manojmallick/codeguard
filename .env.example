# CodeGuard — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Gemini 3 (REQUIRED by hackathon rules). Set ONE backend below. ---
#  A) Vertex AI on a Vertex-enabled GCP project (uses ADC: `gcloud auth application-default login`):
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
#  B) AI Studio / Gemini Developer API (for gen-lang-client projects — key at
#     https://aistudio.google.com/apikey ). If set, takes precedence over Vertex:
# GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3

# --- GitLab (partner) ---
GITLAB_API_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Shared secret your .gitlab-ci.yml / webhook sends to authenticate to this service:
CODEGUARD_TOKEN=choose-a-long-random-string

# --- App ---
PORT=8080
NODE_ENV=development

# --- Demo mode: set MOCK=true to run the full UI + ApprovalBar flow with
# canned data and NO credentials (great for rehearsing the ~3-min demo). ---
# MOCK=true
